# Personal access token из Figma: Settings → Security → Personal access tokens.
# Достаточно прав на чтение файла (file_content:read, file_comments:read).
# Нужен только для tools/figma-pull.mjs, в сборку не попадает.
FIGMA_TOKEN=

# Ключ файла и стартовый узел — из ссылки на макет:
# figma.com/design/<FILE_KEY>/...?node-id=<NODE_ID>
FIGMA_FILE_KEY=FFET7OgqcO6yHIPUaotnto
FIGMA_NODE_ID=4:3
